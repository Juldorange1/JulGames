{
  "name": "colosses",
  "productName": "Colosses",
  "version": "1.0.0",
  "description": "Colosses - boss rush infini (programme pour Windows)",
  "author": "Juldorange",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:muet": "electron . --muet",
    "build": "electron-builder --win dir portable",
    "prebuild": "node manifeste.js"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.juldorange.colosses",
    "productName": "Colosses",
    "copyright": "Juldorange",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "maj.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "game",
        "filter": [
          "index.html",
          "icon.png",
          "version.json",
          "css/**/*",
          "js/**/*",
          "img/**/*",
          "fonts/**/*",
          "music/**/*",
          "sfx/**/*"
        ]
      }
    ],
    "win": {
      "icon": "../icon.png",
      "target": [
        "dir",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Colosses-${version}-portable.exe"
    },
    "asar": true,
    "executableName": "Colosses",
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "afterPack": "./alleger.js"
  }
}
