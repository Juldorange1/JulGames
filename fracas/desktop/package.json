{
  "name": "fracas",
  "productName": "Fracas",
  "version": "1.0.0",
  "description": "Fracas - action 2D vue du dessus (version programme pour Windows / Steam)",
  "author": "Juldorange",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:muet": "electron . --muet",
    "build": "electron-builder --win dir portable",
    "build:dir": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.juldorange.fracas",
    "productName": "Fracas",
    "copyright": "Juldorange",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "game",
        "filter": [
          "index.html",
          "style.css",
          "icon.png",
          "js/**/*",
          "music/**/*",
          "art/**/*"
        ]
      }
    ],
    "win": {
      "icon": "../icon.png",
      "target": [
        "dir",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Fracas-${version}-portable.exe"
    },
    "asar": true
  },
  "allowScripts": {
    "electron@38.8.6": true
  }
}
