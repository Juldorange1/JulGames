{
  "name": "stratajium",
  "productName": "Panthéa",
  "version": "1.0.0",
  "description": "Panthéa - stratégie façon échecs (programme pour Windows)",
  "author": "Juldorange",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:muet": "electron . --muet",
    "icon": "electron make-icon.js",
    "build": "electron-builder --win dir portable"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.juldorange.stratajium",
    "productName": "Panthéa",
    "copyright": "Juldorange",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "game",
        "filter": [
          "index.html",
          "style.css",
          "icon.png",
          "js/**/*",
          "fonts/**/*",
          "music/**/*",
          "sfx/**/*",
          "img/**/*"
        ]
      }
    ],
    "win": {
      "icon": "../icon.png",
      "target": [
        "dir",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Panthea-${version}-portable.exe"
    },
    "asar": true,
    "executableName": "Panthea"
  }
}
